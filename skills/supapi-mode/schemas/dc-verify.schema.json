{
  "type": "object",
  "required": ["verdict", "criteria", "lanes", "findings"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "issues", "blocked"]
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "result", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^DC-[1-9][0-9]*$" },
          "result": { "type": "string", "enum": ["PASS", "ISSUES", "BLOCKED"] },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000,
            "pattern": "\\S"
          }
        },
        "additionalProperties": false
      }
    },
    "lanes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "result", "artifact", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^LANE-[1-9][0-9]*$" },
          "result": { "type": "string", "enum": ["PASS", "ISSUES", "BLOCKED"] },
          "artifact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000,
            "pattern": "\\S"
          }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "target", "why", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "target": {
            "type": "string",
            "pattern": "^(DC-[1-9][0-9]*|LANE-[1-9][0-9]*|diff)$"
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000,
            "pattern": "\\S"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
