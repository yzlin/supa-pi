{
  "version": 1,
  "cases": [
    {
      "id": "core-orchestration",
      "workload": "tool-heavy orchestration",
      "promptPath": "extensions/core-prompt/prompt.md",
      "task": "Investigate why the fixture test fails. Delegate one focused exploration task with Agent, verify the returned evidence yourself, and report the root cause with exact file paths. Do not edit files.",
      "tools": ["read", "grep", "find", "ls", "Agent"],
      "checks": [
        {
          "type": "toolCalled",
          "name": "Agent",
          "domain": "task",
          "weight": 2
        },
        {
          "type": "outputIncludes",
          "value": "src/math.ts",
          "domain": "evidence",
          "weight": 1
        },
        {
          "type": "outputMatches",
          "pattern": "subtract|subtraction|left - right",
          "flags": "i",
          "domain": "quality",
          "weight": 1
        }
      ]
    },
    {
      "id": "architect-design",
      "workload": "explanation",
      "promptPath": "agents/architect.md",
      "task": "Explain a minimal architecture change that removes the debug bypass in src/auth.ts while preserving the documented role contract. Cite repository evidence. Do not edit files.",
      "tools": ["read", "grep", "find", "ls"],
      "checks": [
        {
          "type": "outputIncludes",
          "value": "src/auth.ts",
          "domain": "evidence",
          "weight": 1
        },
        {
          "type": "outputMatches",
          "pattern": "debug|bypass",
          "flags": "i",
          "domain": "quality",
          "weight": 1
        }
      ]
    },
