        {
          "type": "outputIncludes",
          "value": "tests/math.case.ts",
          "domain": "evidence",
          "weight": 1
        },
        {
          "type": "outputIncludes",
          "value": "src/math.ts",
          "domain": "evidence",
          "weight": 1
        },
        {
          "type": "outputMatches",
          "pattern": "add\\(7, 5\\).*(?:2|12)|(?:2|12).*add\\(7, 5\\)",
          "flags": "is",
          "domain": "quality",
          "weight": 1
        },
        {
          "type": "outputMatches",
          "pattern": "subtract|left - right",
          "flags": "i",
          "domain": "quality",
          "weight": 1
        },
        {
          "type": "outputIncludes",
          "value": "Diagnosis: Incomplete",
          "domain": "task",
          "weight": 2
        },
        {
          "type": "outputIncludes",
          "value": "Fix: Not attempted",
          "domain": "task",
          "weight": 2
        },
        {
          "type": "outputMatches",
          "pattern": "^(?![\\s\\S]*(?:Approve scoped fix|Stop and clean probes|I (?:can|could|will) fix|recommend(?:ed)? fix|proposed fix|the (?:fix|remedy) is|(?:change|replace) (?:the )?(?:operator|subtraction|left - right)))[\\s\\S]*$",
          "flags": "i",
          "domain": "tests",
          "weight": 2
        },
        {
          "type": "toolNotCalled",
          "name": "questionnaire",
          "domain": "tests",
          "weight": 2
        },
        {
          "type": "workspaceUnchanged",
          "domain": "tests",
          "weight": 3
        }
      ]
    },
