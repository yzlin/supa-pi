          "type": "toolCalledAfter",
          "name": "edit",
          "after": "questionnaire",
          "domain": "tests",
          "weight": 3
        },
        {
          "type": "toolCalledAfter",
          "name": "bash",
          "after": "edit",
          "args": {
            "command": "bun test tests/math.case.ts"
          },
          "domain": "tests",
          "weight": 3
        },
        {
          "type": "fileEquals",
          "path": "src/math.ts",
          "value": "export function add(left: number, right: number): number {\n  return left + right;\n}\n\nexport function multiply(left: number, right: number): number {\n  return left * right;\n}\n",
          "domain": "tests",
          "weight": 3
        },
        {
          "type": "workspaceChangesOnly",
          "paths": ["src/math.ts"],
          "domain": "tests",
          "weight": 3
        }
      ],
      "questionnaireResponse": "Approve scoped fix"
    },
