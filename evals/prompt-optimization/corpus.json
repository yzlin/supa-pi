      "tools": ["read", "grep", "find", "ls", "edit", "write", "bash"],
      "checks": [
        {
          "type": "fileContains",
          "path": "src/math.ts",
          "value": "left + right",
          "domain": "task",
          "weight": 2
        },
        {
          "type": "fileContains",
          "path": "src/math.ts",
          "value": "return left + right;",
          "domain": "tests",
          "weight": 3
        }
