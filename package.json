{
  "name": "supa-pi",
  "version": "1.0.0",
  "description": "Ethan's pi coding agent harness",
  "license": "MIT",
  "bin": {
    "docs-list": "./scripts/docs-list.ts"
  },
  "type": "module",
  "scripts": {
    "check": "oxlint --type-aware && oxfmt --check",
    "check:write": "oxlint --type-aware --fix && oxfmt",
    "eval:prompts": "bun scripts/eval-prompts.ts",
    "eval:prompts:test": "bun test evals/prompt-optimization",
    "eval:plain-report": "bun evals/plain-report/cli.ts",
    "format": "oxfmt",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "bun test"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.0.1",
    "@earendil-works/pi-ai": "1.0.1",
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@earendil-works/pi-tui": "1.0.1",
    "@types/bun": "^1.3.12",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^6.0.3",
    "ultracite": "^7.3.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.0.1",
    "@earendil-works/pi-coding-agent": ">=1.0.1",
    "@earendil-works/pi-tui": ">=1.0.1",
    "typebox": "^1.1.34"
  },
  "pi": {
    "extensions": [
      "./extensions/skill-router",
      "./extensions/ask",
      "./extensions/caveman",
      "./extensions/core-prompt",
      "./extensions/rules",
      "./extensions/subagent",
      "./extensions/execute",
      "./extensions/goal",
      "./extensions/research",
      "./extensions/diagnose",
      "./extensions/code-improvement",
      "./extensions/review",
      "./extensions/session-query.ts",
      "./extensions/handoff.ts",
      "./extensions/context",
      "./extensions/prompt-commands",
      "./extensions/auto-rename",
      "./extensions/context-docs",
      "./extensions/btw",
      "./extensions/rtk",
      "./extensions/tool-display",
      "./extensions/init-deep",
      "./extensions/docs-list",
      "./extensions/sift",
      "./extensions/lsp",
      "./extensions/skills",
      "./extensions/obsidian",
      "./extensions/slack-user",
      "./extensions/notify.ts",
      "./extensions/no-sleep.ts",
      "./extensions/trust-github-repos",
      "./extensions/whimsical",
      "./extensions/fast",
      "./extensions/model-profiles",
      "./extensions/uv.ts"
    ]
  },
  "readme": "README.md"
}
